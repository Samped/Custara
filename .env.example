# Postgres (docker compose or embedded local)
DATABASE_URL="postgresql://custara:custara@127.0.0.1:54329/custara"
REDIS_URL="redis://127.0.0.1:6379"

# Required secrets (rotate in production)
SESSION_SECRET="replace-with-long-random-string"
ENCRYPTION_KEY="replace-with-long-random-string"

# Optional LLM extraction
OPENAI_API_KEY=

# Payment rails — enterprise pilots use real Arc TESTNET (not simulated)
NIGERIA_PAYMENT_LIVE=false
ARC_PAYMENTS_LIVE=true
ARC_CHAIN=ARC-TESTNET
ARC_USDC_TOKEN_ADDRESS=
# Required when ARC_CHAIN=ARC-TESTNET and org paymentMode=live
ARC_ALLOW_LIVE_ON_TESTNET=true
# Fake wallets + invented tx hashes (local demos only). Keep false for customer testing.
ARC_ALLOW_SIMULATED=false

# Circle developer-controlled wallets (required for real agent pay on testnet)
# Console → Developer-controlled wallets → generate/register entity secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Optional stale one-shot ciphertext — app generates a fresh ciphertext per transfer via SDK
CIRCLE_ENTITY_SECRET_CIPHERTEXT=
CIRCLE_API_BASE=https://api.circle.com
CIRCLE_WEBHOOK_SECRET=
# Auto-fund agent on Arc testnet: npm run fund:agent  (uses Circle /v1/faucet/drips)
# Ops: npx tsx scripts/retry-failed-arc.ts | npx tsx scripts/reconcile-pending-arc.ts

# Circle user-controlled sign-in + funding wallet (PRIMARY login)
# Circle sends the OTP email — configure SMTP in Circle Console.
# App ID: Programmable Wallets → User-controlled → your app
AUTH_PROVIDER=circle
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=

# Optional local fallback if Circle App ID is unset (dev only)
# RESEND_API_KEY=
# EMAIL_FROM="Custara <onboarding@resend.dev>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Storage: local | s3
STORAGE_BACKEND=local
STORAGE_ROOT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Enterprise SSO (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=

# Xero OAuth two-way
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/connectors/xero/callback

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/connectors/accounting/qbo/callback
# QBO_DEMO_SYNC=true

# Sage Business Cloud Accounting
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3000/api/connectors/accounting/sage/callback
# SAGE_DEMO_SYNC=true

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/connectors/accounting/zoho/callback
ZOHO_ORGANIZATION_ID=
# ZOHO_DEMO_SYNC=true

# Mailbox inbound ESP webhook
MAILBOX_INBOUND_SECRET=
# MAILBOX_INGEST_DOMAIN=ingest.custara.xyz

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_ORG_ID=

# Nigeria banking reconcile
PAYSTACK_SECRET_KEY=
PAYSTACK_DEFAULT_ORG_ID=
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_DEFAULT_ORG_ID=

# FIRS e-invoice
FIRS_MODE=sandbox

# SFTP / enterprise drop folder
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/incoming

# Embedded Postgres helper
EMBEDDED_PG_PORT=54329

# Production checklist:
# - REDIS_URL reachable; npm run worker
# - STORAGE_BACKEND=s3 with bucket + IAM/MinIO keys
# - OIDC_* + org.ssoEnforced; MFA roles configured
# - ARC_PAYMENTS_LIVE / Circle keys only after compliance
# - XERO_* / QBO_* / SAGE_* / ZOHO_* for accounting sync
# - WhatsApp / Paystack / Mono / SFTP / FIRS for Africa ingest rails
# - GET /api/health returns ok
# - npm test (tenant isolation)
