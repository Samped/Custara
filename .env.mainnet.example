# Empty enterprise stack for https://custara.xyz
# Copy values into a NEW Vercel project and the Render blueprint render.mainnet.yaml.
# Do not reuse testnet DATABASE_URL, ENCRYPTION_KEY, or Circle keys.

DATABASE_URL=
REDIS_URL=

APP_URL=https://custara.xyz
NEXT_PUBLIC_APP_URL=https://custara.xyz

# New secrets — never copy from testnet.
SESSION_SECRET=
ENCRYPTION_KEY=

ALLOW_JIT_ORG_CREATION=true
# After the first workspace exists: set this false and redeploy.

ARC_CHAIN=ARC
ARC_PAYMENTS_LIVE=false
ARC_ALLOW_SIMULATED=false
NIGERIA_PAYMENT_LIVE=false
# African bank Fund/Withdraw (NGN, GHS, TZS, KES, ZAR). Set on the Vercel app.
PAJ_API_KEY=
PAJ_WEBHOOK_SECRET=
# Webhook URL in PAJ: https://custara.xyz/api/webhooks/paj
# Required before ARC_PAYMENTS_LIVE=true
ARC_USDC_TOKEN_ADDRESS=

PLATFORM_FEE_BPS=75
PLATFORM_FEE_MIN_USDC=0.10
PLATFORM_FEE_ADDRESS=

# New Circle MAINNET developer-controlled wallet app
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_SECRET_CIPHERTEXT=
CIRCLE_API_BASE=https://api.circle.com
CIRCLE_WEBHOOK_SECRET=
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=
# Webhook URL in Circle: https://custara.xyz/api/webhooks/circle

OPENAI_API_KEY=
AUTH_PROVIDER=circle

STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PLATFORM_ADMIN_EMAILS=
